# Fireworks API (required for SED chat, memory, judge, and embeddings)
# Create a key at: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=

# Chat / memory / judge model IDs (must be deployed on your Fireworks account).
# Verify with:
#   curl https://api.fireworks.ai/inference/v1/models -H "Authorization: Bearer $FIREWORKS_API_KEY"
# Paper defaults map to the current Fireworks IDs below.
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
FIREWORKS_MEMORY_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
JUDGE_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731

# Also reported in the paper (swap into the three vars above if you prefer):
# FIREWORKS_MODEL=accounts/fireworks/models/glm-5p2
# FIREWORKS_MODEL=accounts/fireworks/models/kimi-k3

# Optional OpenAI key (only if you point JUDGE_MODEL at a non-Fireworks id)
OPENAI_API_KEY=
